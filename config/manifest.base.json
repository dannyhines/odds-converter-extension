{
  "name": "Odds to Implied Probability",
  "short_name": "OddsConvert",
  "description": "Convert American odds to implied probability, including live odds that change on the page.",
  "version": "4.0.0",
  "manifest_version": 3,
  "author": "Danny Hines",
  "action": {
    "default_title": "Odds Converter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "/images/converter-icon16.png",
      "24": "/images/converter-icon24.png",
      "32": "/images/converter-icon32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "js": ["js/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "/images/converter-icon16.png",
    "32": "/images/converter-icon32.png",
    "48": "/images/converter-icon48.png",
    "128": "/images/converter-icon128.png"
  }
}
