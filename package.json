{
  "name": "odds-converter",
  "version": "4.0.0",
  "description": "A live American-odds to implied-probability Chrome extension",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "webpack --config config/webpack.config.js",
    "validate:build": "node scripts/validate-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run validate:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannyhines/odds-converter-extension.git"
  },
  "author": "Danny Hines",
  "license": "ISC",
  "engines": {
    "node": ">=24.15.0"
  },
  "bugs": {
    "url": "https://github.com/dannyhines/odds-converter-extension/issues"
  },
  "homepage": "https://github.com/dannyhines/odds-converter-extension#readme",
  "devDependencies": {
    "@types/chrome": "0.2.6",
    "copy-webpack-plugin": "14.0.0",
    "jsdom": "30.0.1",
    "ts-loader": "9.6.2",
    "typescript": "^5.9.3",
    "vitest": "4.1.10",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  }
}
